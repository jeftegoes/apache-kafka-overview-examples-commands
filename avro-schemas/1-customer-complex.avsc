{
  "type": "record",
  "namespace": "com.example",
  "name": "Customer",
  "doc": "Avro schema for a Customer",
  "fields": [
    {
      "name": "first_name",
      "type": "string",
      "doc": "Customer's first name"
    },
    {
      "name": "last_name",
      "type": "string",
      "doc": "Customer's last name"
    },
    {
      "name": "age",
      "type": "int",
      "doc": "Customer's age in years"
    },
    {
      "name": "height",
      "type": "float",
      "doc": "Customer's height in centimeters"
    },
    {
      "name": "weight",
      "type": "float",
      "doc": "Customer's weight in kilograms"
    },
    {
      "name": "automated_email",
      "type": "boolean",
      "default": true,
      "doc": "Indicates whether automated emails are enabled"
    },
    {
      "name": "customer_emails",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": [],
      "doc": "List of email addresses associated with the customer"
    },
    {
      "name": "customer_address",
      "type": {
        "type": "record",
        "name": "CustomerAddress",
        "doc": "Customer's address information",
        "fields": [
          {
            "name": "address",
            "type": "string",
            "doc": "Customer's street address"
          },
          {
            "name": "city",
            "type": "string",
            "doc": "Customer's city"
          },
          {
            "name": "postcode",
            "type": ["int", "string"],
            "doc": "Customer's postal code"
          },
          {
            "name": "type",
            "type": {
              "type": "enum",
              "name": "AddressType",
              "symbols": ["PO_BOX", "RESIDENTIAL", "ENTERPRISE"]
            },
            "doc": "Type of customer address"
          }
        ]
      }
    }
  ]
}
